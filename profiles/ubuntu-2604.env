# OS profile: Ubuntu 26.04 LTS
# Sourced by build-template.sh and deploy-vm.sh. Values here are OS-specific;
# connection/placement/sizing live in config.env.
OS_ID="ubuntu-2604"
TEMPLATE_NAME="ubuntu-2604-template"
IMAGE_URL="https://cloud-images.ubuntu.com/releases/26.04/release/ubuntu-26.04-server-cloudimg-amd64.ova"
IMAGE_FORMAT="ova"                 # ova = import directly

# Per-VM deploy defaults for this OS
DEFAULT_USERNAME="ubuntu"
ADMIN_GROUP="sudo"                 # Debian/Ubuntu admin group
SSH_SERVICE="ssh"                  # systemd unit name for sshd on Ubuntu
DEFAULT_IFACE="ens192"             # vmxnet3 NIC name in-guest
