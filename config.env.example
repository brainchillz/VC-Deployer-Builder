# Copy to `config.env` and fill in. `config.env` is git-ignored (secrets).
#   cp config.env.example config.env

# ---- govc / vCenter connection ------------------------------------------------
export GOVC_URL="https://vcenter.example.com"     # vCenter FQDN or IP
export GOVC_USERNAME="administrator@vsphere.local"
export GOVC_PASSWORD="change-me"
export GOVC_INSECURE="1"                            # 1 to skip TLS verify (self-signed)

# Placement (used by both import and clone). Set the ones your vCenter needs.
export GOVC_DATACENTER="Datacenter"
export GOVC_DATASTORE="datastore1"
export GOVC_RESOURCE_POOL="Cluster/Resources"      # e.g. "MyCluster/Resources"
export GOVC_FOLDER="vm"                             # VM folder for new VMs
export GOVC_NETWORK="VM Network"                    # portgroup the NIC attaches to

# ---- Which OS profile is used when --profile / [PROFILE] is omitted -----------
# OS-specific settings (image URL, template name, username, admin group, ssh unit,
# NIC name) live in profiles/*.env — NOT here. Ships with: ubuntu-2604,
# ubuntu-2404, rocky-10. Copy one to add another OS.
DEFAULT_PROFILE="ubuntu-2604"

# ---- Global template build sizing (applies to every profile) ------------------
TEMPLATE_CPUS="2"
TEMPLATE_MEMORY_MB="2048"
TEMPLATE_DISK_GB=""                                 # e.g. "40" to grow the root disk; blank = leave as-is

# ---- Per-VM network deploy defaults (overridable by deploy-vm.sh flags) -------
DEFAULT_CIDR="24"                                   # set to your subnet's prefix length
DEFAULT_DNS="1.1.1.1, 8.8.8.8"
DEFAULT_SSH_KEY="$HOME/.ssh/id_ed25519.pub"         # public key injected into the user
