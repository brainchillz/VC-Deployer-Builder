# OS profile: Rocky Linux 9
# Same GenericCloud qcow2 path as rocky-10: build-template.sh converts it to a
# streamOptimized VMDK, uploads it, builds a VM shell, and preps via seed ISO.
OS_ID="rocky-9"
TEMPLATE_NAME="rocky-9-template"
IMAGE_URL="https://dl.rockylinux.org/pub/rocky/9/images/x86_64/Rocky-9-GenericCloud.latest.x86_64.qcow2"
IMAGE_FORMAT="qcow2"               # needs qemu-img conversion + a hand-built VM

# Hardware for the VM shell we create around the imported disk
GUEST_ID="rhel9_64Guest"           # native EL9 guest id
FIRMWARE="bios"                    # try bios first; switch to efi if it won't boot
DISK_CONTROLLER="pvscsi"           # generic EL initramfs includes vmw_pvscsi

# Per-VM deploy defaults for this OS
DEFAULT_USERNAME="rocky"
ADMIN_GROUP="wheel"                # EL admin group is 'wheel', NOT 'sudo'
SSH_SERVICE="sshd"                 # systemd unit is 'sshd' on EL, NOT 'ssh'
DEFAULT_IFACE="eth0"    # GenericCloud images boot net.ifnames=0
