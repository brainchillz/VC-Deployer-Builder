# OS profile: Windows Server 2025 (Evaluation, Desktop Experience)
# Microsoft ships a pre-installed evaluation VHD — no installer pass needed.
# build-template.sh converts it to a streamOptimized VMDK, builds a VM shell,
# and preps it via an autounattend seed ISO (OOBE answers + first-logon script
# that installs VMware Tools + Cloudbase-Init, then sysprep /generalize).
# Deploys are configured by Cloudbase-Init reading the SAME guestinfo.* keys
# the Linux images read with cloud-init. DHCP-only in v1.
OS_ID="windows-2025"
TEMPLATE_NAME="windows-2025-template"
IMAGE_URL="https://go.microsoft.com/fwlink/?linkid=2345826&clcid=0x409&culture=en-us&country=us"
IMAGE_FILE="windows-server-2025-eval.vhd"   # fwlink has no usable basename
IMAGE_FORMAT="vhd"                 # qemu-img auto-probes vpc vs vhdx

# Hardware for the VM shell we create around the imported disk.
# Everything here works with Windows' IN-BOX drivers — VMware Tools (pvscsi,
# vmxnet3) only exists after prep.
GUEST_ID="windows2022srvNext_64Guest"   # vSphere guest id covering Server 2025
FIRMWARE="efi"                     # the 2025 eval image is VHDX / GPT (Generation 2 —
                                   # verified: ESP with EFI\Boot\bootx64.efi; BIOS won't boot it)
DISK_CONTROLLER="lsilogic-sas"     # in-box Windows driver (pvscsi needs Tools)
NET_ADAPTER="e1000e"               # in-box driver (vmxnet3 needs Tools)

# Per-VM deploy defaults for this OS (annotation contract)
OS_FAMILY="windows"                # clients branch on this (absent = linux)
DEFAULT_USERNAME="admin"           # created by Cloudbase-Init at deploy time
ADMIN_GROUP="Administrators"
SSH_SERVICE="sshd"                 # Windows OpenSSH Server service name
DEFAULT_IFACE="Ethernet0"          # informational; Windows deploys are DHCP-only

# Server 2025 (Desktop Experience) needs more than the global 2 vCPU / 2 GB to
# prep in reasonable time; deploys can downsize with --cpus / --memory.
TEMPLATE_CPUS="4"
TEMPLATE_MEMORY_MB="8192"

# Prep-only local Administrator password (lives ONLY inside the one-time prep
# boot; sysprep /generalize wipes it before the VM ever becomes a template).
PREP_ADMIN_PASSWORD="Prep-0nly-Passw0rd!"
